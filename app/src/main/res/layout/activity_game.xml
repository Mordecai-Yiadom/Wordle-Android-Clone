                    android:paddingRight="2dp"
                    android:text="M"
                    android:textAlignment="center"
                    app:cornerRadius="25px" />

                <Button
                    android:id="@+id/keyboard_BACKSPACE"
                    android:layout_width="48dp"
                    android:layout_height="53dp"
                    android:backgroundTint="#BFBFBF"
                    android:backgroundTintMode="add"
                    android:drawableTint="#000000"
                    android:foregroundTint="#0B0B0B"
                    android:padding="2dp"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:textAlignment="center"
                    app:cornerRadius="25px"
                    app:icon="@drawable/backspace"
                    app:iconPadding="2dp"
                    app:iconSize="40dp" />
            </TableRow>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/debugMenu"
            android:layout_width="183dp"
            android:layout_height="70dp"
            android:layout_marginStart="3dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="225dp"
            android:layout_marginBottom="420dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/keyboard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/debugHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Debug Info"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/debug_AttemptCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AttemptCount: 0" />

            <TextView
                android:id="@+id/debug_AttemptBuffer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AttemptBuffer: -empty-" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/keyboard_Q"
        android:layout_width="34dp"
        android:layout_height="54dp"
        android:layout_marginStart="30dp"
        android:backgroundTint="#BFBFBF"
        android:padding="2dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:text="Q"
        android:textAlignment="center"
        app:cornerRadius="25px"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/main"
        tools:layout_editor_absoluteY="446dp"
        tools:text="Q" />

</androidx.constraintlayout.widget.ConstraintLayout>